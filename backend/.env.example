# Defaults only — anything saved in the UI settings panel overrides these
# without a restart. Copy to .env and edit.

# --- Model ---------------------------------------------------------------
# OpenAI-compatible endpoint. Default is a local Ollama.
PAKASH_LLM_BASE_URL=http://localhost:11434/v1
PAKASH_LLM_MODEL=gemma3:27b
# Optional per-role overrides. Empty URLs fall back to PAKASH_LLM_BASE_URL.
PAKASH_LLM_MODEL_FAST=
PAKASH_LLM_BASE_URL_FAST=
PAKASH_LLM_MODEL_DEFAULT=
PAKASH_LLM_BASE_URL_DEFAULT=
PAKASH_LLM_MODEL_ADVANCED=
PAKASH_LLM_BASE_URL_ADVANCED=
PAKASH_LLM_TIMEOUT_SECONDS=120
# Compact prompts and bounded completions.
PAKASH_LLM_DIET_MODE=false
# vLLM/Ollama/TGI extension, sent in extra_body. 0 = do not send it at all
# (OpenAI itself rejects the key). 1.0 is neutral on servers that support it.
PAKASH_LLM_REPETITION_PENALTY=0.0
# How many completions may be in flight at once, process-wide. Unlike the
# settings above, this one is read ONCE at start-up — the semaphore it sizes
# cannot be resized — so changing it needs a restart.
#
# The right value depends entirely on what serves the model:
#   vLLM / TGI  -> 16 or more. They batch continuously and a low limit here
#                  STARVES them: a request held back is one they cannot batch.
#   Ollama      -> 1-2. It serves one request at a time and is only thrashed.
PAKASH_LLM_MAX_CONCURRENCY=1

# Read UNPREFIXED, as the OpenAI SDK expects. Leave empty for local servers —
# they ignore auth and a placeholder is sent.
OPENAI_API_KEY=

# --- Database ------------------------------------------------------------
# jdbc:postgresql://... is accepted and converted automatically.
PAKASH_DATABASE_URL=postgresql://pakash:pakash@localhost:5432/pakash
PAKASH_DATABASE_SCHEMA=pakash

# --- Runtime -------------------------------------------------------------
PAKASH_RUNTIME_SETTINGS_FILE=runtime-settings.json
PAKASH_LOG_LEVEL=INFO

# Signs the workspace session cookie. REQUIRED in any real deployment.
#
# Left empty, each process generates its own: sessions die on every restart,
# and with more than one worker they break constantly, because each worker
# rejects the cookies the others signed. That failure looks like random
# logouts, not like a missing setting, which is why the app refuses to start
# with multiple workers unless this is set.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PAKASH_SESSION_SECRET=
