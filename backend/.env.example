# Defaults only — anything saved in the system settings (the צוות משמרות זהב
# console at /admin, "מערכת" tab) overrides these without a restart, on every
# replica: saves are kept in the database (D39), except the database fields.
# Copy to .env and edit.

# --- Model ---------------------------------------------------------------
# OpenAI-compatible endpoint. Default is a local Ollama.
PAKASH_LLM_BASE_URL=http://localhost:11434/v1
PAKASH_LLM_MODEL=gemma3:27b
# Optional per-role overrides. Empty values fall back to the general ones.
PAKASH_LLM_MODEL_FAST=
PAKASH_LLM_BASE_URL_FAST=
PAKASH_LLM_API_KEY_FAST=
PAKASH_LLM_MODEL_DEFAULT=
PAKASH_LLM_BASE_URL_DEFAULT=
PAKASH_LLM_API_KEY_DEFAULT=
PAKASH_LLM_MODEL_ADVANCED=
PAKASH_LLM_BASE_URL_ADVANCED=
PAKASH_LLM_API_KEY_ADVANCED=
# Wall time for ONE HTTP completion. 0 = the built-in ceiling: 300s for chat
# and every other flow, 900s for a build's translation (D38). A stuck call
# fails with a Hebrew error and frees its model slot; a read timeout is not
# retried. Raise it only for a model genuinely slower than that.
PAKASH_LLM_TIMEOUT_SECONDS=0
# How long interactive work may wait for a model slot. 0 = no limit.
PAKASH_LLM_QUEUE_SECONDS=0
# How long a reasoning model thinks: off, low, medium or high. Empty sends
# nothing (a model that does not reason rejects the field). gpt-oss gets
# reasoning_effort; Qwen3 gets enable_thinking=false on off/low.
PAKASH_LLM_REASONING_EFFORT=
# Compact prompts and bounded completions.
PAKASH_LLM_DIET_MODE=false
# The model server's TLS certificate is never verified (PAKASH_LLM_VERIFY_SSL
# is ignored): the deployment's model servers use internal certificates.
# vLLM/Ollama/TGI extension, sent in extra_body. 0 = do not send it at all
# (OpenAI itself rejects the key). 1.0 is neutral on servers that support it.
PAKASH_LLM_REPETITION_PENALTY=0.0
# Model calls in flight across every process (API and workers), coordinated
# with PostgreSQL advisory locks and read on each acquisition, so a saved
# change applies to the next call.
#   vLLM / TGI  -> 16 or more. They batch continuously; a low limit starves them.
#   Ollama      -> 1-2. It serves one request at a time.
PAKASH_LLM_MAX_CONCURRENCY=4
# How many of those one team may hold at once. 0 = all of them.
PAKASH_LLM_TEAM_CONCURRENCY=0

# Read UNPREFIXED, as the OpenAI SDK expects. Leave empty for local servers —
# they ignore auth and a placeholder is sent.
OPENAI_API_KEY=

# --- Solver (D34) --------------------------------------------------------
# Wall time of one CP-SAT solve, and its parallel search workers.
PAKASH_SOLVER_TIME_LIMIT_SECONDS=10
PAKASH_SOLVER_WORKERS=8
# Solver threads one process runs at once (default: the CPU count); a solve
# waits for its share. Set per process when the API and a worker share a host.
# PAKASH_SOLVER_CPU_BUDGET=

# --- Database ------------------------------------------------------------
# PostgreSQL holds every piece of shared state (D35): data, the job queue,
# the login throttle, live signals (LISTEN/NOTIFY) and the model slots.
# jdbc:postgresql://... is accepted and converted automatically.
PAKASH_DATABASE_URL=postgresql://pakash:pakash@localhost:5432/pakash
PAKASH_DATABASE_SCHEMA=pakash
# Pooled connections per process. With several replicas,
# replicas x (this + 1 + model calls in flight) must stay under max_connections.
# PAKASH_DATABASE_POOL_SIZE=16

# --- Many teams (docs/SCALING.md) -----------------------------------------
# API processes in the backend container (compose -> WEB_CONCURRENCY).
# PAKASH_API_WORKERS=4
# The compose PostgreSQL: size memory to the host (shared_buffers ~1/4 RAM,
# effective_cache_size ~3/4), connections to the processes above.
# PAKASH_PG_MAX_CONNECTIONS=200
# PAKASH_PG_SHARED_BUFFERS=512MB
# PAKASH_PG_EFFECTIVE_CACHE_SIZE=1536MB
# PAKASH_PG_WORK_MEM=16MB
# PAKASH_PG_LOG_SLOW_MS=500
# Optional explicit parts; each overrides the same part of the URL.
# PAKASH_DATABASE_HOST=
# PAKASH_DATABASE_PORT=
# PAKASH_DATABASE_NAME=
# PAKASH_DATABASE_USER=
# PAKASH_DATABASE_PASSWORD=

# --- Worker --------------------------------------------------------------
# The job worker runs inside the API process unless this is off (compose
# turns it off and runs `python -m app.worker` as its own service).
# PAKASH_EMBEDDED_WORKER=true
# Worker threads, and how many of them take only manager-chat turns.
# PAKASH_WORKER_CONCURRENCY=6
# PAKASH_CHAT_WORKERS=3
# Finished jobs are deleted after this many days, checked hourly.
# PAKASH_JOB_RETENTION_DAYS=30
# Seconds an idle worker lane waits before asking the queue again.
# PAKASH_COPILOT_POLL_SECONDS=1

# --- Runtime -------------------------------------------------------------
PAKASH_RUNTIME_SETTINGS_FILE=runtime-settings.json
# DEBUG also logs refused (401) reads, which are otherwise kept out of the log.
PAKASH_LOG_LEVEL=INFO

# Signs the workspace session cookie.
#
# Left empty, one key is generated and kept in the database, so every
# replica and every restart signs with the same one (D39). Only with no
# database at all does each process generate its own -- and then the app
# refuses to start with more than one worker, since each would reject the
# cookies the others signed. Setting it is still the cleaner choice:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PAKASH_SESSION_SECRET=
# How long a manager stays signed in, in days.
# PAKASH_SESSION_DAYS=30

# The system settings (model endpoints, API keys, database URL) are shared by
# every team. They are edited from the operator console; the settings API
# also admits a team session carrying this password in X-Settings-Password.
# Unset, the committed default (010802) applies; set to empty, that path
# stays locked.
# PAKASH_SETTINGS_PASSWORD=

# The צוות משמרות זהב operator console at /admin (D28): opens, suspends and
# deletes teams, and edits the system settings. Empty means "the same as the
# settings password". Set it in any real deployment -- the committed default
# can delete every team on the server.
# PAKASH_ADMIN_PASSWORD=
# How long an operator stays signed in, in hours.
# PAKASH_ADMIN_SESSION_HOURS=12
# Let anyone open a team from the login page. Off by default: teams are opened
# by the operator.
# PAKASH_OPEN_SIGNUP=false
