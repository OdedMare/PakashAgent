    {"id":"docs_build_order_build_plan","label":"PakashAgent Build Plan","file_type":"document","source_file":"/Users/odedmarellie/Desktop/repos/PakashAgent/docs/BUILD_ORDER.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"docs_build_order_python_version_resolution","label":"Python Version Resolution","file_type":"rationale","source_file":"/Users/odedmarellie/Desktop/repos/PakashAgent/docs/BUILD_ORDER.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Python 3.8.10 mirrors a likely external deployment constraint but is EOL; using 3.11+ is cheaper if that constraint does not apply."},
    {"id":"docs_build_order_audit_first_implementation","label":"Audit-First Implementation","file_type":"rationale","source_file":"/Users/odedmarellie/Desktop/repos/PakashAgent/docs/BUILD_ORDER.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The audit is deterministic, easy to test exactly, and trusted by all downstream scheduling behavior, so it should precede model-driven work."},
    {"id":"docs_build_order_importer_fixture_strategy","label":"Importer Fixture Strategy","file_type":"rationale","source_file":"/Users/odedmarellie/Desktop/repos/PakashAgent/docs/BUILD_ORDER.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Two deliberately different real layouts prevent an importer from accidentally encoding one orientation as a universal template."},

    {"id":"docs_decisions_d1_hard_and_soft_rules","label":"D1 Hard and Soft Rules","file_type":"rationale","source_file":"/Users/odedmarellie/Desktop/repos/PakashAgent/docs/DECISIONS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Hard rules must hold and soft rules are optimized toward, with the distinction captured during the interview."},
    {"id":"docs_decisions_d2_natural_language_rules","label":"D2 Rules Stay Natural Language","file_type":"rationale","source_file":"/Users/odedmarellie/Desktop/repos/PakashAgent/docs/DECISIONS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Once code no longer enforces rules, a structured rule engine and vocabulary add complexity without serving an enforcement need."},
    {"id":"docs_decisions_d3_agent_decides_code_audits","label":"D3 Agent Decides; Code Only Audits","file_type":"rationale","source_file":"/Users/odedmarellie/Desktop/repos/PakashAgent/docs/DECISIONS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The boss chose a pure-agent product; deterministic code catches subtle arithmetic errors but only reports warnings, preserving the agent's judgment even for hard-rule violations."},
    {"id":"docs_decisions_d4_living_schedule","label":"D4 Living Schedule, Not Versioned","file_type":"rationale","source_file":"/Users/odedmarellie/Desktop/repos/PakashAgent/docs/DECISIONS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Current assignment state and an append-only reasoned change log answer real operational questions without the cost of snapshots, diffs, and rollback semantics."},
    {"id":"docs_decisions_d5_read_only_employees","label":"D5 Employees Are Read-Only","file_type":"rationale","source_file":"/Users/odedmarellie/Desktop/repos/PakashAgent/docs/DECISIONS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Employee consent could let one unresponsive person hold a schedule hostage and would require deadlines, escalation, and boss overrides."},
    {"id":"docs_decisions_d6_author_or_generate","label":"D6 Boss Can Author or Generate","file_type":"rationale","source_file":"/Users/odedmarellie/Desktop/repos/PakashAgent/docs/DECISIONS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Import is a first-class path because the agent must reason about schedules it did not author; authored and generated schedules therefore share one representation."},
    {"id":"docs_decisions_d7_infer_then_confirm_import","label":"D7 Import Infers Layout, Boss Confirms","file_type":"rationale","source_file":"/Users/odedmarellie/Desktop/repos/PakashAgent/docs/DECISIONS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A fixed template fails for pre-existing schedules, and the two supplied real samples already use structurally different axes."},
    {"id":"docs_decisions_d8_two_required_reasons","label":"D8 Two Reasons, Both Required","file_type":"rationale","source_file":"/Users/odedmarellie/Desktop/repos/PakashAgent/docs/DECISIONS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The boss's reason preserves historical facts that cannot be reconstructed, while the agent's reason exposes its judgment for inexpensive review before confirmation."},
    {"id":"docs_decisions_d9_per_workplace_shift_vocabulary","label":"D9 Shift Vocabulary Is Per-Workplace","file_type":"rationale","source_file":"/Users/odedmarellie/Desktop/repos/PakashAgent/docs/DECISIONS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Real files disagree on shift sets; collecting names, times, and on-call semantics from the boss is more accurate and simpler than hardcoding a guessed union."},

